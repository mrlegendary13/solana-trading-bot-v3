# Wallet
# Base58 secret key, a JSON array of 64 bytes, or a 12/24-word seed phrase. Never a public key.
PRIVATE_KEY=your_base58_secret_key

# Connection
# Helius Developer: 50 RPC requests/s and 5 sendTransaction/s.
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WEBSOCKET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional send-only URL, such as a Helius staked connection. Leave commented to send on RPC_ENDPOINT.
# SEND_RPC_ENDPOINT=https://staked.helius-rpc.com?api-key=YOUR_KEY
COMMITMENT_LEVEL=confirmed

# Bot
# trace, debug, info, warn, error, or fatal.
LOG_LEVEL=info
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=false
# default, warp, or jito. Ignored while DRY_RUN=true.
TRANSACTION_EXECUTOR=default
# Compute-unit price in micro-lamports. 200000 * 250000 CU = 0.00005 SOL.
COMPUTE_UNIT_LIMIT=250000
COMPUTE_UNIT_PRICE=200000
# Tip in SOL for warp or jito only.
CUSTOM_FEE=0.0006
# Sign locally and do not broadcast. Leave this true until a simulation looks right.
DRY_RUN=true
# Close an empty token account after a full sell.
CLOSE_EMPTY_TOKEN_ACCOUNTS=true
# Wait this many milliseconds times the attempt number before the next retry.
RETRY_BACKOFF_MS=400

# Venues
ENABLE_RAYDIUM=false
ENABLE_PUMPFUN=true
ENABLE_PUMPSWAP=true

# Buy
# WSOL is the internal quote. Pump.fun spends native SOL. PumpSwap and Raydium wrap and unwrap inside the transaction.
QUOTE_MINT=WSOL
QUOTE_AMOUNT=0.05
AUTO_BUY_DELAY=0
MAX_BUY_RETRIES=3
# Percent. A buy that misses this quote is re-quoted once.
BUY_SLIPPAGE=20

# Sell
AUTO_SELL=true
MAX_SELL_RETRIES=10
AUTO_SELL_DELAY=0
# How often to mark an open position, in milliseconds.
PRICE_CHECK_INTERVAL=750
# Sell at market after this many milliseconds if TP and SL have not fired.
PRICE_CHECK_DURATION=600000
PRICE_CHECK_WEBSOCKET=true
# Ignore stop-loss readings for this long after the buy.
SL_GRACE_MS=2000
# Stop-loss readings required in a row.
SL_CONFIRMATIONS=2
# After a failed sell, wait this long, then re-read the balance and try again.
SELL_RETRY_INTERVAL_MS=15000
# How often to log Position PnL at info. 0 hides the line.
PNL_LOG_INTERVAL_MS=10000
# Gap between RPC starts, in-flight calls, heavy-call gap, and send gap.
# 20 / 8 / 40 / 200 matches the Helius Developer plan.
RPC_MIN_INTERVAL_MS=20
RPC_MAX_CONCURRENCY=8
RPC_HEAVY_INTERVAL_MS=40
RPC_SEND_INTERVAL_MS=200
RPC_RETRY_ATTEMPTS=3
RPC_RETRY_BUDGET_MS=1500
# Take profit and stop loss, in percent from the SOL that actually went into the trade.
TAKE_PROFIT=40
STOP_LOSS=20
SELL_SLIPPAGE=30
# Added to SELL_SLIPPAGE after TooLittleSolReceived. The last attempt accepts any output.
SELL_SLIPPAGE_STEP=10

# Raydium filters. Unused while ENABLE_RAYDIUM=false.
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=30000
FILTER_CHECK_DURATION=60000
FILTER_CHECK_INTERVAL=2000
CONSECUTIVE_FILTER_MATCHES=1
CHECK_IF_MUTABLE=true
CHECK_IF_SOCIALS=false
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=true
CHECK_IF_BURNED=true
MIN_POOL_SIZE=5
MAX_POOL_SIZE=50

# pump.fun filters. A numeric 0 disables that bound.
# Curve progress is the percent of the initial real token reserves already sold.
PUMP_MIN_CURVE_PROGRESS=5
PUMP_MAX_CURVE_PROGRESS=100
# Virtual-reserve market cap, in SOL.
PUMP_MIN_MARKET_CAP_SOL=35
PUMP_MAX_MARKET_CAP_SOL=0
PUMP_MIN_DEV_BUY_SOL=0
PUMP_MAX_DEV_BUY_SOL=0
PUMP_MAX_CREATOR_HOLD_PERCENT=0
PUMP_MIN_UNIQUE_BUYERS=0
PUMP_BUYER_WAIT_MS=0
PUMP_MAX_REAL_SOL=0
# Mayhem coins price off virtual reserves that can exceed the SOL in the curve.
PUMP_SKIP_MAYHEM=true
# Token-2022 pump coins do not use Metaplex metadata.
PUMP_CHECK_IF_MUTABLE=false
# Non-SOL quotes are recognized and skipped. Buys are SOL-only.
PUMP_ALLOW_NON_SOL_QUOTE=false
# One base58 creator per line. A missing file means an empty list.
PUMP_CREATOR_BLACKLIST=pump-creator-blacklist.txt

# Quality filters. A percent or count of 0 disables that one check.
QUALITY_FILTERS=true
QUALITY_CHECK_SELLABLE=true
MAX_TRANSFER_FEE_BPS=0
MAX_SINGLE_HOLDER_PCT=25
MAX_TOP10_PCT=60
MAX_DEV_BUY_PCT=15
MAX_CREATOR_LAUNCHES=3
QUALITY_WAIT_MS=3000
QUALITY_MIN_TRADES=3
QUALITY_MIN_UNIQUE_BUYERS=3
QUALITY_MIN_BUY_SELL_RATIO=1
QUALITY_MAX_SAME_SLOT_BUYS=2
QUALITY_MIN_REAL_SOL=2
# RugCheck score above the max skips the mint. Fail open allows the buy when the request errors.
RUGCHECK_ENABLED=true
RUGCHECK_MAX_SCORE=1000
RUGCHECK_TIMEOUT_MS=8000
RUGCHECK_FAIL_OPEN=true
